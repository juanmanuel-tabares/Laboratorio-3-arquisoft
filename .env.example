# Copie este archivo como .env (que no se sube a Git) y complete los valores.
# Clave del usuario root de MySQL que usan los servidores MCP.
PWD_UDEA=
# Puerto de MySQL (3306 por defecto; el laboratorio se ejecutó con un contenedor en 3307).
MYSQL_PORT=3306
# Clave de la API de Gemini (agente ADK y chatbot). Se puede guardar con scripts/configurar-gemini.sh.
GOOGLE_API_KEY=
